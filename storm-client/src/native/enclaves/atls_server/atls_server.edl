enclave {
    from "openenclave/edl/syscall.edl" import *;
    from "openenclave/edl/logging.edl" import *; // allows to set log callbacks
    from "platform.edl" import *;
#ifdef EDL_USE_HOST_ENTROPY
    from "openenclave/edl/sgx/entropy.edl" import *;
#endif

    trusted {
        public int ecall_set_up_tls_server([in, string] char* port, bool keep_server_up);
        public void ecall_set_log_callback();
    };

    untrusted {
        // Signal from enclave that server is ready (bound and listening)
        void ocall_server_ready();
        void ocall_transfer_logs_to_file([in, count=size] const char* modified_log, size_t size);
    };
};
