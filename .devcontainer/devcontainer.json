{
  "name": "Apache Storm devcontainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "runArgs": ["--name", "storm-atls-devcontainer"],
  "remoteUser": "vscode",
  "postCreateCommand": "",
  "mounts": [
    {
      "source": "${localEnv:HOME}/.config/nvim",
      "target": "/home/vscode/.config/nvim",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.tmux.linux.conf",
      "target": "/home/vscode/.tmux.conf",
      "type": "bind"
    }
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": true
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "amzn",
      "installMaven": true,
      "mavenVersion": "3.9.7",
      "installGradle": false,
      "installAnt": false
    },
    "ghcr.io/duduribeiro/devcontainer-features/neovim:1": {
      "version": "stable"
    },
    "ghcr.io/duduribeiro/devcontainer-features/tmux:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
        "packages": "ripgrep,fzf"
    }
  },
}
